# Git LFS tracking
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.whl filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.model filter=lfs diff=lfs merge=lfs -text

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf

# Markdown
*.md text eol=lf

# TOML/YAML/JSON
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Shell scripts
*.sh text eol=lf eof=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# C/C++
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.inl text eol=lf
*.ipp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.cmake.in text eol=lf

# Protobuf
*.proto text eol=lf
# Protobuf binary wire format / compiled descriptor sets (NOT generated source code)
*.pb binary
*.pb.bin binary
*.desc binary
# Generated *_pb2.py are Python source files (text, LF) - pre-generated and committed
# Generated *.pb.cc/*.pb.h are C++ source files (text, LF) - in build/, gitignored

# Binary files (no CRLF conversion, no text diff)
# Note: LFS-tracked binaries (*.png/*.jpg/*.so/*.dll etc.) are configured above with -text;
# here we cover non-LFS binaries.
*.a binary
*.lib binary
*.o binary
*.obj binary
*.exe binary
*.pyd binary
*.pyc binary
*.pyo binary
*.class binary
*.jar binary
*.war binary
*.ear binary
*.7z binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.rar binary
*.bmp binary
*.ico binary
*.tif binary
*.tiff binary
*.webp binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.avi binary
*.mov binary
*.mkv binary
*.flv binary
*.wmv binary
*.webm binary
*.egg binary
*.bin binary
*.safetensors binary
*.npy binary
*.npz binary
*.pkl binary
*.pickle binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.ttf binary
*.otf binary
*.woff binary
