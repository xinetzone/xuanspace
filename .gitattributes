# Lock files and logs: text but skip line-ending normalization
*.lock -text
package-lock.json -text
yarn.lock -text
pnpm-lock.yaml -text
*.log -text

# Configuration files
*.cfg text eol=lf
*.conf text eol=lf
*.ini text eol=crlf
*.reg text eol=crlf
*.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf
.dockerignore text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
